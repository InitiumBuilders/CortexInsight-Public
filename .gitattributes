# store text as LF; check out as the platform prefers
* text=auto

# binaries
*.ico binary
*.icns binary
# the macOS install script keeps LF whatever the checkout platform
*.sh text eol=lf
*.png binary
*.jpg binary
*.woff binary
*.woff2 binary

# Linux carries shell and python; both must land with LF wherever they are checked out
*.py eol=lf
